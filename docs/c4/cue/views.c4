views {

    view index {
        title "How CUE works"
        include *
        autoLayout TopBottom
    }

    view organisation of organisation {
        title "Modules, packages, instances"
        include *
        include organisation.module.cuemod.*
        include cli.exportCmd, cli.modTidyCmd
        exclude organisation.files
        autoLayout TopBottom
    }

    view files of organisation.files {
        title "File and directory names the loader treats specially"
        include *
        include organisation.pkgInstance, cli.cmdCmd
        autoLayout LeftRight
    }

    view lattice of lattice {
        title "The Value Lattice"
        include *
        autoLayout TopBottom
    }

    view lattice-bool {
        title "The Value Lattice: booleans"
        include
            lattice.topValue,
            lattice.boolType,
            lattice.trueValue,
            lattice.falseValue,
            lattice.bottomValue
        autoLayout TopBottom
    }

    view lattice-numbers {
        title "The Value Lattice: numbers and constraints"
        include
            lattice.topValue,
            lattice.numberType,
            lattice.intType,
            lattice.atLeastHalf,
            lattice.belowTen,
            lattice.zero,
            lattice.one,
            lattice.onePointOne,
            lattice.twenty,
            lattice.bottomValue
        autoLayout TopBottom
    }

    view evaluation of evaluation {
        title "Evaluation"
        include *
        include lattice.topValue, lattice.bottomValue, lattice.definition
        include cli.exportCmd, cli.vetCmd, cli.evalCmd
        autoLayout LeftRight
    }

    dynamic view unification-walk {
        title "Unification walks down the lattice"
        lattice.topValue -> lattice.boolType "_ & bool = bool"
        lattice.boolType -> lattice.trueValue "bool & true = true"
        lattice.trueValue -> lattice.bottomValue "true & false = _|_" {
            notes "No value is both true and false, so the meet is bottom: an error."
        }
        lattice.topValue -> lattice.numberType "_ & number"
        lattice.numberType -> lattice.intType "& int"
        lattice.intType -> lattice.one "& >=0.5 & <10 & 1 = 1" {
            notes "Order does not matter. Any sequence of the same constraints reaches the same meet."
        }
    }

    dynamic view export-flow {
        title "What cue export ./dir does"
        variant sequence
        cli.exportCmd -> organisation.module "find the nearest cue.mod/ above ./dir"
        cli.exportCmd -> organisation.pkgInstance "load the instance for ./dir"
        organisation.pkgInstance -> organisation.files.packaged "collect same-package files in ./dir and each ancestor"
        organisation.files.packaged -> organisation.imports.builtin "resolve builtin imports"
        organisation.files.packaged -> organisation.imports.local "resolve same-module imports"
        organisation.files.packaged -> organisation.imports.external "resolve external imports"
        organisation.imports.external -> organisation.cache "read the module, fetching from the registry if missing"
        organisation.pkgInstance -> evaluation.unify "unify every file and import"
        evaluation.unify -> evaluation.concrete "check that every emitted value is concrete"
        cli.exportCmd <- evaluation.concrete "print JSON, YAML, or text, or fail with the incomplete paths"
    }
}
