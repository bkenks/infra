$ORIGIN internal.
$TTL 60

@   IN SOA  ns.internal. hostmaster.internal. (
            2026100104  ; serial — bump on every edit
            7200        ; refresh
            3600        ; retry
            1209600     ; expire
            60 )        ; negative TTL

@   IN NS   ns.internal.
ns  IN A    10.200.0.53

