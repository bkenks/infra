#!/usr/bin/env bash
# Wrapper Script for Docker Compose Command
# Usage:
#   `./nodewrap <host> docker compose up -d`
#   `./nodewrap <host> docker compose down`

set -euo pipefail

arg_host=${1:?usage: nodewrap <host> <command...>}
shift

export HOST=$arg_host
export FNOX_PROFILE=node,node-$arg_host
export COMPOSE_PROFILES=all
set -a; . /mnt/credentials/onepassword.env; set +a
exec fnox exec -- "$@"