{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "vendir.schema.json",
    "title": "vendir.yml",
    "description": "Carvel vendir configuration (apiVersion vendir.k14s.io/v1alpha1, kind Config).",
    "type": "object",
    "additionalProperties": false,
    "required": ["apiVersion", "kind", "directories"],
    "properties": {
      "apiVersion": { "const": "vendir.k14s.io/v1alpha1" },
      "kind": { "const": "Config" },
      "minimumRequiredVersion": {
        "type": "string",
        "description": "Minimum required vendir binary version, e.g. 0.8.0."
      },
      "directories": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/directory" }
      }
    },
    "$defs": {
      "permissions": {
        "description": "Directory permissions (v0.33.0+). Octal values need a leading 0, e.g. 0700.",
        "type": ["integer", "string"]
      },
      "secretRef": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      },
      "stringList": {
        "type": "array",
        "items": { "type": "string" }
      },
      "versionSelection": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "semver": {
            "type": "object",
            "additionalProperties": false,
            "required": ["constraints"],
            "properties": {
              "constraints": { "type": "string", "description": "Semver constraints, e.g. \">0.4.0\"." },
              "prereleases": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "identifiers": { "$ref": "#/$defs/stringList" }
                }
              }
            }
          }
        }
      },
      "directory": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "contents"],
        "properties": {
          "path": { "type": "string", "description": "Relative to the vendir CLI working directory." },
          "permissions": { "$ref": "#/$defs/permissions" },
          "contents": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/contents" }
          }
        }
      },
      "contents": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "oneOf": [
          { "required": ["git"] },
          { "required": ["hg"] },
          { "required": ["http"] },
          { "required": ["image"] },
          { "required": ["imgpkgBundle"] },
          { "required": ["githubRelease"] },
          { "required": ["helmChart"] },
          { "required": ["directory"] },
          { "required": ["manual"] },
          { "required": ["inline"] }
        ],
        "properties": {
          "path": { "type": "string", "description": "Relative to the parent directory path." },
          "lazy": { "type": "boolean", "description": "Skip fetching if config is unchanged since last sync (v0.36.0+)." },
          "git": { "$ref": "#/$defs/git" },
          "hg": { "$ref": "#/$defs/hg" },
          "http": { "$ref": "#/$defs/http" },
          "image": { "$ref": "#/$defs/image" },
          "imgpkgBundle": { "$ref": "#/$defs/imgpkgBundle" },
          "githubRelease": { "$ref": "#/$defs/githubRelease" },
          "helmChart": { "$ref": "#/$defs/helmChart" },
          "directory": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "description": "Local path relative to vendir.yml." }
            }
          },
          "manual": {
            "type": "object",
            "additionalProperties": false,
            "description": "Directory is managed by hand."
          },
          "inline": { "$ref": "#/$defs/inline" },
          "includePaths": { "$ref": "#/$defs/stringList" },
          "excludePaths": { "$ref": "#/$defs/stringList" },
          "legalPaths": { "$ref": "#/$defs/stringList" },
          "ignorePaths": { "$ref": "#/$defs/stringList" },
          "newRootPath": { "type": "string" },
          "permissions": { "$ref": "#/$defs/permissions" }
        }
      },
      "git": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "anyOf": [{ "required": ["ref"] }, { "required": ["refSelection"] }],
        "properties": {
          "url": { "type": "string" },
          "ref": { "type": "string", "description": "Branch, tag, or commit, e.g. origin/main." },
          "depth": { "type": "integer", "minimum": 0 },
          "refSelection": { "$ref": "#/$defs/versionSelection" },
          "lfsSkipSmudge": { "type": "boolean" },
          "dangerousSkipTLSVerify": { "type": "boolean" },
          "skipInitSubmodules": { "type": "boolean" },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "publicKeysSecretRef": { "$ref": "#/$defs/secretRef" },
              "allowLegacySignatures": { "type": "boolean" }
            }
          },
          "secretRef": { "$ref": "#/$defs/secretRef" },
          "forceHTTPBasicAuth": { "type": "boolean" }
        }
      },
      "hg": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "ref"],
        "properties": {
          "url": { "type": "string" },
          "ref": { "type": "string" },
          "evolve": { "type": "boolean" },
          "secretRef": { "$ref": "#/$defs/secretRef" }
        }
      },
      "http": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "url": { "type": "string" },
          "sha256": { "type": "string" },
          "secretRef": { "$ref": "#/$defs/secretRef" },
          "disableUnpack": { "type": "boolean" }
        }
      },
      "image": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "description": "Omit the tag when tagSelection is set." },
          "tagSelection": { "$ref": "#/$defs/versionSelection" },
          "secretRef": { "$ref": "#/$defs/secretRef" },
          "dangerousSkipTLSVerify": { "type": "boolean" },
          "responseHeaderTimeout": { "type": "integer", "minimum": 0 }
        }
      },
      "imgpkgBundle": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image"],
        "properties": {
          "image": { "type": "string", "description": "Omit the tag when tagSelection is set." },
          "tagSelection": { "$ref": "#/$defs/versionSelection" },
          "secretRef": { "$ref": "#/$defs/secretRef" },
          "dangerousSkipTLSVerify": { "type": "boolean" },
          "responseHeaderTimeout": { "type": "integer", "minimum": 0 },
          "recursive": { "type": "boolean" },
          "additionalCACertificates": { "$ref": "#/$defs/stringList" }
        }
      },
      "githubRelease": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[^/]+/[^/]+$", "description": "org/repo" },
          "tag": { "type": "string" },
          "tagSelection": { "$ref": "#/$defs/versionSelection" },
          "latest": { "type": "boolean" },
          "url": { "type": "string" },
          "assetNames": { "$ref": "#/$defs/stringList" },
          "checksums": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "disableAutoChecksumValidation": { "type": "boolean" },
          "unpackArchive": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": { "path": { "type": "string" } }
          },
          "secretRef": { "$ref": "#/$defs/secretRef" },
          "http": { "$ref": "#/$defs/http" }
        }
      },
      "helmChart": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "repository": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "description": "Supports oci:// scheme." },
              "secretRef": { "$ref": "#/$defs/secretRef" }
            }
          },
          "helmVersion": { "type": "string" }
        }
      },
      "inline": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "paths": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "pathsFrom": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "oneOf": [{ "required": ["secretRef"] }, { "required": ["configMapRef"] }],
              "properties": {
                "secretRef": { "$ref": "#/$defs/inlineSourceRef" },
                "configMapRef": { "$ref": "#/$defs/inlineSourceRef" }
              }
            }
          }
        }
      },
      "inlineSourceRef": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "directoryPath": { "type": "string" }
        }
      }
    }
  }
  