examples {
  ["template compose.yaml"] {
    """
    # GENERATED from stack.pkl — DO NOT EDIT.
    name: example
    services:
      secrets:
        provider:
          type: docker-compose-fnox
          options:
            path_config_toml: fnox.toml
            path_credentials_env: /mnt/credentials/onepassword.env
            if_missing: error
      app:
        image: ghcr.io/example/example:latest
        container_name: example-app
        hostname: app
        restart: on-failure:5
        environment:
          DB_HOST: db
          DB_NAME: example
          DB_USER: example
          APP_URL: https://example.ktbinternal.com
        expose:
        - 8080
        volumes:
        - type: volume
          source: app_data
          target: /data
          read_only: false
        networks:
        - default
        - newt_gw_001
        depends_on:
          secrets:
            condition: service_started
            required: false
          db:
            condition: service_healthy
        healthcheck:
          test:
          - CMD
          - curl
          - -fsS
          - --max-time
          - '2'
          - http://localhost:8080
          interval: 30s
          timeout: 10s
          retries: 5
      db:
        image: docker.io/library/postgres:18
        container_name: example-db
        hostname: db
        restart: on-failure:5
        environment:
          POSTGRES_USER: example
          POSTGRES_DB: example
        expose:
        - 5432
        volumes:
        - type: volume
          source: db_data
          target: /var/lib/postgresql/data
          read_only: false
        networks:
        - default
        - newt_gw_001
        depends_on:
          secrets:
            condition: service_started
            required: false
        healthcheck:
          test:
          - CMD-SHELL
          - pg_isready --username=example
          interval: 5s
          timeout: 10s
          retries: 10
    volumes:
      app_data:
        name: example-app_data
      db_data:
        name: example-db_data
    networks:
      newt_gw_001:
        name: newt_gw_001
        external: true
      default:
        name: example
    
    """
  }
  ["file-browser-quantum compose.yaml"] {
    """
    # GENERATED from stack.pkl — DO NOT EDIT.
    name: file-browser-quantum
    services:
      app:
        image: gtstef/filebrowser:stable
        container_name: file-browser-quantum-app
        hostname: app
        restart: unless-stopped
        expose:
        - 80
        volumes:
        - type: bind
          source: ./files/config.yaml
          target: /home/filebrowser/data/config.yaml
          read_only: true
        - type: bind
          source: /rootless-srv/file-browser-quantum/data
          target: /data
          read_only: false
        - type: bind
          source: /rootless-srv/file-browser-quantum/shared
          target: /shared
          read_only: false
        - type: bind
          source: /rootless-srv/file-browser-quantum/cache
          target: /cache
          read_only: false
        networks:
        - default
        - newt_gw_001
    networks:
      newt_gw_001:
        name: newt_gw_001
        external: true
      default:
        name: file-browser-quantum
    
    """
  }
  ["databasus bootstrap.yaml"] {
    """
    # GENERATED from stack.pkl — DO NOT EDIT.
    name: databasus
    services:
      app:
        image: databasus/databasus:latest
        container_name: databasus-app
        hostname: app
        restart: unless-stopped
        env_file:
        - ${BOOTSTRAP_SECRETS_FILE:-/mnt/secrets/databasus.env}
        ports:
        - target: 4005
          published: 4005
          protocol: tcp
        volumes:
        - type: volume
          source: app_data
          target: /databasus-data
          read_only: false
        network_mode: host
        pre_start:
        - command:
          - sh
          - -c
          - umask 077; printf %s "$$SECRET_KEY" > /databasus-data/secret.key
          image: alpine:3.20
    volumes:
      app_data:
        name: databasus-app_data
    networks:
      newt_gw_001:
        name: newt_gw_001
        external: true
      default:
        name: databasus
    
    """
  }
  ["infisical compose.yaml"] {
    """
    # GENERATED from stack.pkl — DO NOT EDIT.
    name: infisical
    include:
    - path: services.yaml
      env_file:
      - ${BOOTSTRAP_SECRETS_FILE:-/mnt/secrets/infisical.env}
    
    """
  }
}
