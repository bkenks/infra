amends "pkl:test"

import "../src/apps/storage/file-browser-quantum/stack.pkl" as fileBrowser
import "../src/platform/backup-manager/databasus/stack.pkl" as databasus
import "../src/platform/secrets-manager/infisical/stack.pkl" as infisical
import "../src/templates/stack/stack.pkl" as template

facts {
  ["every rendered file starts with the GENERATED header"] {
    template.output.files["compose.yaml"].text.startsWith("# GENERATED from stack.pkl")
  }
  ["template derives container and volume names from the project name"] {
    template.services["app"].container_name == "example-app"
    template.volumes["db_data"].name == "example-db_data"
  }
  ["the secrets provider renders without a container"] {
    template.services["secrets"].container_name == null
    template.services["app"].depends_on.containsKey("secrets")
  }
  ["the bootstrap variant drops the provider and takes the env file"] {
    !databasus.output.files["bootstrap.yaml"].text.contains("provider:")
    databasus.output.files["bootstrap.yaml"].text.contains("BOOTSTRAP_SECRETS_FILE")
    databasus.output.files["compose.yaml"].text.contains("provider:")
  }
}

examples {
  ["template compose.yaml"] { template.output.files["compose.yaml"].text }
  ["file-browser-quantum compose.yaml"] { fileBrowser.output.files["compose.yaml"].text }
  ["databasus bootstrap.yaml"] { databasus.output.files["bootstrap.yaml"].text }
  ["infisical compose.yaml"] { infisical.output.files["compose.yaml"].text }
}
