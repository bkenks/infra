// komodo-mcp: exposes Komodo to MCP clients (Claude Code) via Traefik, guarded by
// basic-auth. The MCP endpoint has no auth of its own and the configured key is full
// read/write.
amends "@infra/Stack.pkl"

import "@infra/collections.pkl" as col
import "@infra/secrets.pkl"

local version = "v1.7.1"
local port = 8000

name = "komodo-mcp"

services {
  ["secrets"] = secrets.fnox

  ["app"] {
    image = "fj.\(col.domain.ktbcloud)/bkenks/komodo-mcp-server:\(version)"
    restart = "unless-stopped"
    depends_on = secrets.ready
    environment {
      // Streamable HTTP transport (listens on :8000 inside the container).
      ["MCP_TRANSPORT"] = "http"
      ["MCP_ALLOWED_HOSTS"] = "\(module.name).\(col.domain.ktbinternal)"
      ["KOMODO_URL"] = "http://host.docker.internal:9120"
      // Trust the first hop (this host's Traefik) to resolve the real client IP from
      // X-Forwarded-*.
      ["MCP_TRUST_PROXY"] = "1"
      ["TZ"] = "America/Chicago"
    }
    extra_hosts { "host.docker.internal:host-gateway" }
    expose { port }
    // No `init = true`: the image's own tini is already PID 1; Docker's init would nest a
    // second tini as a non-PID-1 child and break zombie reaping.
    labels = col.labels.komodoSkip
  }
}

output {
  files {
    [secrets.configFile] =
      secrets.config("komodo-mcp", new Listing {
        "KOMODO_API_KEY"
        "KOMODO_API_SECRET"
        "KOMODO_MCP_BASICAUTH_USERS"
      })
  }
}
