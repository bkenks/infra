// openhands: Agent Canvas, the OpenHands web UI for running coding agents (its own agent,
// or Claude Code / Codex over ACP) against the projects mounted at /projects.
amends "@infra/Stack.pkl"

import "@infra/collections.pkl" as col
import "@infra/secrets.pkl"

local version = "latest"
local port = 8000
local projectsDir = "\(col.dirs.docker.bindMounts)/openhands/projects"

name = "openhands"

services {
  ["secrets"] = secrets.fnox

  ["app"] {
    image = "ghcr.io/openhands/agent-canvas:\(version)"
    restart = "on-failure:5"
    stdin_open = true
    tty = true
    depends_on = secrets.ready
    environment { ["TZ"] = "America/Chicago" }
    expose { port }
    // Settings, secrets and conversation history: the container's ~/.openhands.
    data { ["home"] { target = "/home/openhands/.openhands" } }
    volumes { col.bind(projectsDir, "/projects") }
  }
}

output {
  files {
    [secrets.configFile] =
      secrets.config("openhands", new Listing { "LOCAL_BACKEND_API_KEY"; "OH_SECRET_KEY" })
  }
}
