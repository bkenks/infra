// Immich needs its own Postgres (vectorchord/pgvecto extensions); it does NOT join the
// shared cluster. Postgres and the ML model cache live on local NVMe bind mounts (Postgres
// must NOT live on NFS); the photo/video library is a separate NFS export at the literal
// host path /mnt/immich-library.
amends "@infra/Stack.pkl"

import "@infra/collections.pkl" as col
import "@infra/secrets.pkl"

local dbImage =
  "ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23"
local mlImage = "ghcr.io/immich-app/immich-machine-learning:v2.7.5"
local appImage = "ghcr.io/immich-app/immich-server:v2.7.5"
local cacheImage =
  "docker.io/valkey/valkey:9@sha256:8436e10bc65c94886a91d4415b6a6dfa9cb5a306fb3b996e5bb67cd2b4854193"

local port = 2283
local tz = "America/New_York"
local bindRoot = "\(col.dirs.docker.bindMounts)/apps/immich"

name = "immich"

services {
  ["secrets"] = secrets.fnox

  ["db"] {
    image = dbImage
    restart = "unless-stopped"
    depends_on = secrets.ready
    volumes { col.bind("\(bindRoot)/postgres", "/var/lib/postgresql/data") }
    environment {
      ["POSTGRES_DB"] = module.name
      ["POSTGRES_USER"] = module.name
      ["POSTGRES_INITDB_ARGS"] = "--data-checksums"
    }
    shm_size = 128.mib
  }

  ["ml"] {
    image = mlImage
    restart = "unless-stopped"
    volumes { col.bind("\(bindRoot)/model-cache", "/cache") }
    environment { ["TZ"] = tz }
  }

  ["cache"] {
    image = cacheImage
    restart = "unless-stopped"
  }

  ["app"] {
    image = appImage
    restart = "unless-stopped"
    depends_on {
      ...secrets.ready
      ["db"] { condition = "service_started" }
      ["cache"] { condition = "service_started" }
    }
    volumes { col.bind("/mnt/immich-library", "/data") }
    // Intel Quick Sync HW transcoding (paiki's N150 iGPU), the equivalent of the
    // `quicksync` service in Immich's hwaccel.transcoding.yml. Enable it in the UI:
    // Admin -> Video Transcoding -> Acceleration API -> Quick Sync.
    devices { "/dev/dri:/dev/dri" }
    environment {
      ["TZ"] = tz
      ["REDIS_HOSTNAME"] = "cache"
      ["DB_HOSTNAME"] = "db"
      ["DB_USERNAME"] = module.name
      ["DB_DATABASE_NAME"] = module.name
    }
    expose { port }
  }
}

output {
  files {
    [secrets.configFile] =
      secrets.config("immich", new Listing { "DB_PASSWORD"; "POSTGRES_PASSWORD" })
  }
}
