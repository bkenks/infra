// Services are keyed by the role each app plays in the media pipeline; the product behind
// a role can change without renaming its container. All storage is host bind mounts, so
// this stack owns no volumes.
amends "@infra/Stack.pkl"

import "@compose/Compose.pkl"
import "@infra/collections.pkl" as col
import "@infra/secrets.pkl"

local tz = "America/New_York"
local restartPolicy = "on-failure:5"
local bindRoot = "\(col.dirs.docker.bindMounts)/stream"

// The linuxserver.io images drop to this uid/gid; the bind mounts under bindRoot are owned
// by it. media (plex) and requests (seerr) opt out; see their notes.
local lsioEnv = new Mapping { ["PUID"] = "1000"; ["PGID"] = "1000"; ["TZ"] = tz }

// Shared TRaSH-layout data mount so the *arr apps hardlink imports instead of copying
// (downloads + library on one device). Do NOT add nested submounts.
local sharedData = "\(bindRoot)/shared"

local versions = new {
  bazarr = "1.5.4"
  configarr = "1.28.0"
  decluttarr = "v2.1.0"
  plex = "1.43.3"
  seerr = "v3.0.1"
}

local port = new {
  subtitles = 6767
  media = 32400
  indexer = 9696
  movies = 7878
  downloader = 8080
  requests = 5055
  tv = 8989
}

// Every one of these images ships curl and answers on loopback, so the healthchecks differ
// only in port and path.
local function httpHealth(port: Int, path: String): Compose.Healthcheck = new {
  test { "CMD-SHELL"; "curl -fsS http://localhost:\(port)\(path) || exit 1" }
  interval = 30.s
  timeout = 10.s
  retries = 5
  start_period = 30.s
}

// seeder (configarr) and janitor (decluttarr) both drive the *arr APIs, so both wait for
// them to be healthy rather than merely started.
local arrsHealthy = new Mapping<String, Compose.DependsOn> {
  ["movies"] { condition = "service_healthy" }
  ["tv"] { condition = "service_healthy" }
}

name = "stream"

services {
  ["secrets"] = secrets.fnox

  ["subtitles"] {
    image = "lscr.io/linuxserver/bazarr:\(versions.bazarr)"
    restart = restartPolicy
    volumes {
      col.bind("\(bindRoot)/bazarr/config", "/config")
      col.bind(sharedData, "/data")
    }
    environment = lsioEnv
    healthcheck = httpHealth(port.subtitles, "/")
    expose { port.subtitles }
  }

  // One-shot: syncs ./configarr/config.yml into Sonarr/Radarr on each deploy, then exits 0.
  ["seeder"] {
    image = "ghcr.io/raydak-labs/configarr:\(versions.configarr)"
    restart = restartPolicy
    depends_on { ...secrets.ready; ...arrsHealthy }
    volumes {
      col.bindReadOnly("./configarr", "/app/config")
      col.bind("\(bindRoot)/configarr/repos", "/app/repos")
    }
    environment = lsioEnv
  }

  // Long-running: every `timer` minutes scans the Sonarr/Radarr queues, removes
  // failed/stalled/slow/orphaned downloads, and triggers a re-search.
  ["janitor"] {
    image = "ghcr.io/manimatter/decluttarr:\(versions.decluttarr)"
    restart = restartPolicy
    depends_on { ...secrets.ready; ...arrsHealthy }
    volumes { col.bindReadOnly("./decluttarr", "/app/config") }
    environment = lsioEnv
  }

  // network_mode: host (NOT Traefik-fronted); GPU passthrough (Intel iGPU) for hardware
  // transcoding. Runs as root (PUID/PGID 0), so no group_add for render is needed.
  // Compose rejects network_mode and networks on the same service, so this one declares
  // no networks at all.
  ["media"] {
    image = "lscr.io/linuxserver/plex:\(versions.plex)"
    restart = restartPolicy
    network_mode = "host"
    depends_on = secrets.ready
    volumes {
      col.bind("\(bindRoot)/plex/config", "/config")
      col.bind("\(sharedData)/media", "/data/media")
    }
    environment {
      ["PUID"] = "0"
      ["PGID"] = "0"
      ["TZ"] = tz
      // "docker" = pinned-by-image, no in-container update.
      ["VERSION"] = "docker"
    }
    devices { "/dev/dri:/dev/dri" }
    healthcheck = httpHealth(port.media, "/identity")
  }

  ["indexer"] {
    image =
      "lscr.io/linuxserver/prowlarr@sha256:d3e9307b320b6772749a2cf8fc2712e9e824c4930b034680ad4d08a9e2f25884"
    restart = restartPolicy
    volumes { col.bind("\(bindRoot)/prowlarr/config", "/config") }
    environment = lsioEnv
    healthcheck = httpHealth(port.indexer, "/ping")
    expose { port.indexer }
  }

  ["movies"] {
    image =
      "lscr.io/linuxserver/radarr@sha256:270f25698624b57b86ca119cc95399d7ff15be8297095b4e1223fd5b549b732c"
    restart = restartPolicy
    volumes {
      col.bind("\(bindRoot)/radarr/config", "/config")
      col.bind(sharedData, "/data")
    }
    environment = lsioEnv
    healthcheck = httpHealth(port.movies, "/ping")
    expose { port.movies }
  }

  ["downloader"] {
    image =
      "lscr.io/linuxserver/sabnzbd@sha256:fba727f777f6b2633fcdeaea94abc85d73148f2a6b19a8158907bdd5b6e145d0"
    restart = restartPolicy
    volumes {
      col.bind("\(bindRoot)/sabnzbd/config", "/config")
      col.bind(sharedData, "/data")
    }
    environment = lsioEnv
    healthcheck = httpHealth(port.downloader, "/")
    expose { port.downloader }
  }

  // Runs as the fixed non-root `node` user (UID 1000); PUID/PGID have no effect; needs
  // `init = true`. No healthcheck: the image ships no curl/wget/bash.
  ["requests"] {
    image = "ghcr.io/seerr-team/seerr:\(versions.seerr)"
    restart = restartPolicy
    volumes { col.bind("\(bindRoot)/seerr/config", "/app/config") }
    environment { ["TZ"] = tz }
    expose { port.requests }
    init = true
  }

  ["tv"] {
    image =
      "lscr.io/linuxserver/sonarr@sha256:02b4d538d351d6e35882a021c08e8600fe95d28860fb1dd724b597166e7221ca"
    restart = restartPolicy
    volumes {
      col.bind("\(bindRoot)/sonarr/config", "/config")
      col.bind(sharedData, "/data")
    }
    environment = lsioEnv
    healthcheck = httpHealth(port.tv, "/ping")
    expose { port.tv }
  }
}

output {
  files {
    [secrets.configFile] =
      secrets.config("stream", new Listing { "RADARR_API_KEY"; "SONARR_API_KEY" })
  }
}
