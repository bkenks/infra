// Reads /var/lib/docker/volumes off the host (a bind mount, not a docker network), so it
// owns no shared network. BASE_URL points at the control plane rather than at whichever
// host this copy runs on, so every instance advertises the same address.
//
// Restore tier: renders bootstrap.yaml too, so it can come up on a cold start alongside
// databasus.
amends "@infra/Stack.pkl"

import "@infra/collections.pkl" as col
import "@infra/registry.pkl"
import "@infra/secrets.pkl"

local version = "v0.40"
local port = 4096

name = "zerobyte"

services {
  when (!module.bootstrap) {
    ["secrets"] = secrets.fnox
  }

  ["app"] {
    image = "ghcr.io/nicotsx/zerobyte:\(version)"
    restart = "unless-stopped"
    when (module.bootstrap) {
      env_file { module.bootstrapSecretsFile }
    } else {
      depends_on = secrets.ready
    }
    data { ["data"] { target = "/var/lib/zerobyte" } }
    volumes {
      col.bindReadOnly("/etc/localtime", "/etc/localtime")
      col.bind("/var/lib/docker/volumes", "/source/docker-volumes")
    }
    environment {
      ["TZ"] = "America/New_York"
      ["BASE_URL"] = "http://\(registry.endpoint.hostGroup.littlebuddy.ref):\(port)"
    }
    // Core infra, no proxy in front of it.
    ports { new { target = port; published = port; host_ip = null } }
    cap_add { "SYS_ADMIN" }
    devices { "/dev/fuse:/dev/fuse" }
    security_opt { "apparmor:unconfined" }
  }
}

output {
  files {
    [secrets.configFile] = secrets.config("zerobyte", new Listing { "APP_SECRET" })
    ["bootstrap.yaml"] = module.file((module) { bootstrap = true })
  }
}
