// Restore tier: renders bootstrap.yaml too, so it can come up on a cold start to restore
// the Infisical volume.
amends "@infra/Stack.pkl"

import "@infra/secrets.pkl"

local version = "latest"
local port = 4005

name = "databasus"

services {
  when (!module.bootstrap) {
    ["secrets"] = secrets.fnox
  }

  ["app"] {
    image = "databasus/databasus:\(version)"
    restart = "unless-stopped"
    when (module.bootstrap) {
      env_file { module.bootstrapSecretsFile }
    } else {
      depends_on = secrets.ready
    }
    // databasus reads its key from a file, and neither the provider nor an env file does
    // anything but set environment variables. The hook runs before the container starts,
    // with SECRET_KEY already injected, and writes it into the data volume the container
    // then reads. `$$` escapes compose's interpolation so the shell in the hook expands it
    // rather than compose resolving it to nothing. The hook needs its own entrypoint-less
    // image: without one Compose reuses the service image, whose /app/start.sh entrypoint
    // swallows the command as arguments and never exits, hanging the deploy.
    pre_start {
      new {
        image = "alpine:3.20"
        command { "sh"; "-c"; "umask 077; printf %s \"$$SECRET_KEY\" > /databasus-data/secret.key" }
      }
    }
    data { ["data"] { target = "/databasus-data" } }
    ports { new { target = port; published = port; host_ip = null } }
    // No private bridge: the one service runs in the host netns. It reaches the databases
    // it backs up over the .internal zone, which every host's CoreDNS resolves; configure each
    // backup target's connection inside databasus.
    network_mode = "host"
  }
}

output {
  files {
    [secrets.configFile] = secrets.config("databasus", new Listing { "SECRET_KEY" })
    ["bootstrap.yaml"] = module.file((module) { bootstrap = true })
  }
}
