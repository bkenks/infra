// The per-host Traefik that fronts containers on this host. Runs in the host netns, so it
// has no networks of its own; its static config renders beside it under config/.
amends "@infra/Stack.pkl"

import "@infra/collections.pkl" as col

local version = "3.7"
local configFile = "traefik.yaml"

name = "container-gw"

services {
  ["proxy"] {
    image = "traefik:v\(version)"
    network_mode = "host"
    volumes {
      col.mounts.dockerSockRW
      col.bindReadOnly("./config/\(configFile)", "/etc/traefik/\(configFile)")
    }
  }
}

output {
  files {
    ["config/\(configFile)"] =
      module.yamlFile(new Dynamic {
        entryPoints { web { address = ":1111" } }
        providers { docker { exposedByDefault = false } }
        log { level = "INFO" }
        accessLog = new Dynamic {}
      })
  }
}
