// Only `seeder` (the one-shot init) takes the derived <project>-<role> container name.
// app/tunnel/proxy are dialled by literal name from outside this stack (gerbil's own
// flags, the Traefik backends Pangolin renders, and ops tooling), so each keeps its bare
// product name as container_name. All storage is a host bind mount, so this stack owns no
// volumes.
amends "@infra/Stack.pkl"

import "@compose/Compose.pkl"
import "@infra/collections.pkl" as col
import "@infra/secrets.pkl"

import "files/config.pkl"

local pangolinVersion = "ee-1.24.0"
local gerbilVersion = "1.5.2"
local traefikVersion = "v3.6"

local configDir = "\(col.dirs.docker.bindMounts)/pangolin/config"
local configs = config.files(col.domain.ktbcloud)

local geoliteMirror =
  "https://github.com/GitSquared/node-geolite2-redist/raw/refs/heads/master/redist/"
local function fetchGeolite(db: String): String =
  "if [ ! -f /mnt/config/GeoLite2-\(db).mmdb ]; then "
    + "wget -qO /tmp/geolite-\(db).tar.gz \(geoliteMirror)GeoLite2-\(db).tar.gz && "
    + "tar -xzf /tmp/geolite-\(db).tar.gz -C /tmp && "
    + "mv /tmp/GeoLite2-\(db)_*/GeoLite2-\(db).mmdb /mnt/config/; "
    + "fi"

// chmod 600 on acme.json MUST run last: a preceding `chmod -R 755 /mnt/config` would
// clobber it back to 755, breaking Traefik ACME.
local initScript =
  List(
    "set -e",
    "mkdir -p /mnt/config/traefik/logs /mnt/config/letsencrypt",
    "touch /mnt/config/letsencrypt/acme.json",
    fetchGeolite("Country"),
    fetchGeolite("ASN"),
    "chmod -R 755 /mnt/config",
    "chmod 600 /mnt/config/letsencrypt/acme.json",
  ).join(" && ")

local initDone = new Mapping<String, Compose.DependsOn> {
  ["seeder"] { condition = "service_completed_successfully" }
}
local appHealthy = new Mapping<String, Compose.DependsOn> {
  ["app"] { condition = "service_healthy" }
}
// Traefik's Cloudflare DNS-01 token is a 1Password item of its own (traefik), shared with
// anything else that does DNS-01 rather than copied into this stack's item. It is injected
// only into traefik, so it takes a second provider reading a config of its own.
local traefikConfig = "traefik/\(secrets.configFile)"
local secretsTraefikReady = new Mapping<String, Compose.DependsOn> {
  ["secrets-traefik"] { condition = "service_started" }
}

name = "pangolin"

services {
  ["secrets"] = secrets.fnox
  ["secrets-traefik"] = secrets.fnoxProvider(traefikConfig)

  // One-shot: creates the config tree/perms + the GeoLite mmdbs (skipped after the first
  // run). It does not provision files/ content; that is the bind mounts below.
  ["seeder"] {
    image = "docker.io/library/busybox:1.37.0"
    restart = "no"
    volumes { col.bind(configDir, "/mnt/config") }
    command { "sh"; "-c"; initScript }
  }

  ["app"] {
    container_name = "pangolin"
    image = "docker.io/fosrl/pangolin:\(pangolinVersion)"
    restart = "unless-stopped"
    depends_on { ...initDone; ...secrets.ready }
    deploy {
      resources {
        limits { memory = 2.gib }
        reservations { memory = 512.mib }
      }
    }
    volumes {
      col.bind(configDir, "/app/config")
      // Generated beside this file; the container paths keep the .yml names Pangolin
      // expects.
      col.bindReadOnly("./files/config.yaml", "/app/config/config.yml")
      col.bindReadOnly("./files/privateConfig.yaml", "/app/config/privateConfig.yml")
    }
    healthcheck {
      test { "CMD"; "curl"; "-f"; "http://localhost:3001/api/v1/" }
      interval = 10.s
      timeout = 10.s
      retries = 15
    }
  }

  ["tunnel"] {
    container_name = "gerbil"
    image = "docker.io/fosrl/gerbil:\(gerbilVersion)"
    restart = "unless-stopped"
    depends_on { ...initDone; ...appHealthy }
    command {
      "--reachableAt=http://gerbil:3004"
      "--generateAndSaveKeyTo=/var/config/key"
      "--remoteConfig=http://pangolin:3001/api/v1/"
    }
    volumes { col.bind(configDir, "/var/config") }
    cap_add { "NET_ADMIN"; "SYS_MODULE" }
    // Public edge ports: these are the host's 80/443, deliberately not loopback-bound.
    ports {
      new { target = 51820; published = 51820; host_ip = null; protocol = "udp" }
      new { target = 21820; published = 21820; host_ip = null; protocol = "udp" }
      new { target = 443; published = 443; host_ip = null }
      // HTTP/3 QUIC
      new { target = 443; published = 443; host_ip = null; protocol = "udp" }
      new { target = 80; published = 80; host_ip = null }
      new { target = 22; published = 22; host_ip = null }
      new { target = 18022; published = 18022; host_ip = null }
    }
  }

  // network_mode: service:tunnel. Traefik shares gerbil's netns so the public ports above
  // front it. Compose rejects networks on a service that shares another's netns, so this
  // one declares none.
  ["proxy"] {
    container_name = "traefik"
    image = "docker.io/library/traefik:\(traefikVersion)"
    restart = "unless-stopped"
    network_mode = "service:tunnel"
    hostname = null
    depends_on { ...initDone; ...appHealthy; ...secretsTraefikReady }
    command { "--configFile=/etc/traefik/traefik_config.yml" }
    volumes {
      // Generated beside this file; the container paths keep the .yml names traefik
      // expects.
      col.bindReadOnly("./files/traefik_config.yaml", "/etc/traefik/traefik_config.yml")
      col.bindReadOnly("./files/dynamic_config.yaml", "/etc/traefik/dynamic_config.yml")
      col.bind("\(configDir)/letsencrypt", "/letsencrypt")
      col.bind("\(configDir)/traefik/logs", "/var/log/traefik")
    }
  }
}

// The edge needs IPv6 on its bridge, which the plain private bridge does not carry.
networks {
  ["default"] { driver = "bridge"; enable_ipv6 = true }
}

output {
  files {
    [secrets.configFile] =
      secrets.config("apps.pangolin", new Listing { "EMAIL_SMTP_PASS"; "SERVER_SECRET" })
    [traefikConfig] = secrets.config("traefik", new Listing { "CF_DNS_API_TOKEN" })
    ["files/config.yaml"] = module.yamlFile(configs.config)
    ["files/dynamic_config.yaml"] = module.yamlFile(configs.dynamic_config)
    ["files/traefik_config.yaml"] = module.yamlFile(configs.traefik_config)
    ["files/privateConfig.yaml"] = module.yamlFile(configs.privateConfig)
  }
}
