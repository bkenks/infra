// The Pangolin site connector every stack that Pangolin exposes attaches to. This stack
// owns the shared network; consumers attach to it and are reached by container name, so
// exposing a service no longer means publishing a loopback port for newt to dial.
//
// Unlike the pangolin-cli client, newt runs its main tunnel on a gvisor netstack rather
// than a kernel WireGuard interface (`--native-main` opts into the latter), so it needs
// no NET_ADMIN, no /dev/net/tun and no host networking.
amends "@infra/Stack.pkl"

import "@infra/registry.pkl"
import "@infra/secrets.pkl"

local appVersion = "1.16.0"
local gateway = registry.network.shared.newt_gw_001

name = "newt-gw"

services {
  ["secrets"] = secrets.fnoxPerHost

  ["app"] {
    image = "docker.io/fosrl/newt:\(appVersion)"
    restart = "unless-stopped"
    depends_on = secrets.ready
    networks { "default"; gateway.name }
    environment {
      ["PANGOLIN_ENDPOINT"] = registry.endpoint.serviceGroup.pangolin.proxy.url
    }
  }
}

output {
  files {
    [secrets.configFile] =
      secrets.hostConfig(
        registry.endpoint.gatewayHosts,
        (host) -> "hosts.\(host).newt",
        new Listing { "NEWT_ID"; "NEWT_SECRET" },
      )
  }
}
