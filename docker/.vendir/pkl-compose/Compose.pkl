/// Typed mirror of the Compose Specification. No opinions, no derived values.
///
/// Property names are the compose keys verbatim (snake_case) so a rendered file
/// can be checked against the spec without a rename table. Long syntax only for
/// ports, mounts, and depends_on.
module Compose

import "Types.pkl"

typealias Restart =
  "no" | "always" | "unless-stopped" | String(matches(Regex(#"^on-failure(:\d+)?$"#)))

typealias DependsCondition =
  "service_started" | "service_healthy" | "service_completed_successfully"

open class Service {
  image: String?(this != null || build != null || provider != null)
  build: Build?
  /// A compose provider service: no container, a plugin that runs at `up`.
  provider: Provider?
  container_name: Types.T1Name?
  hostname: String?
  restart: Restart?
  command: Listing<String>?
  entrypoint: Listing<String>?
  user: String?
  working_dir: String?
  environment: Mapping<String, String | Int | Boolean>
  env_file: Listing<String>
  ports: Listing<Port>
  expose: Listing<UInt16>
  volumes: Listing<Mount>
  tmpfs: Listing<String>
  networks: Listing<String>
  network_mode: String?
  extra_hosts: Listing<String>
  depends_on: Mapping<String, DependsOn>
  healthcheck: Healthcheck?
  deploy: Deploy?
  logging: Logging?
  labels: Mapping<String, String>
  profiles: Listing<String>
  cap_add: Listing<String>
  cap_drop: Listing<String>
  security_opt: Listing<String>
  devices: Listing<String>
  sysctls: Mapping<String, String | Int>
  read_only: Boolean?
  privileged: Boolean?
  init: Boolean?
  stdin_open: Boolean?
  tty: Boolean?
  shm_size: Types.ComposeBytes?
  stop_grace_period: Types.ComposeDuration?
  pre_start: Listing<Hook>
  post_start: Listing<Hook>
}

class Build {
  context: String
  dockerfile: String?
  target: String?
  args: Mapping<String, String>
}

class Provider {
  type: String
  options: Mapping<String, String | Int | Boolean>
}

/// A lifecycle hook. Compose runs it in a one-off container from the service image
/// unless `image` names another; the hook's command is passed to that image's
/// entrypoint, so an image with a long-running entrypoint never returns.
class Hook {
  command: Listing<String>(!isEmpty)
  image: String?
  user: String?
  privileged: Boolean?
  working_dir: String?
  environment: Mapping<String, String>
}

class Port {
  target: UInt16
  published: UInt16 | Types.PortRange
  host_ip: String? | Types.IP
  protocol: "tcp" | "udp" = "tcp"
}

class Mount {
  type: "volume" | "bind" | "tmpfs"
  source: String?(type == "tmpfs" || this != null)
  target: String
  read_only: Boolean = false
}

class DependsOn {
  condition: DependsCondition
  restart: Boolean?
  required: Boolean?
}

class Healthcheck {
  test: Listing<String>(!isEmpty)
  interval: Types.ComposeDuration
  timeout: Types.ComposeDuration
  retries: UInt
  start_period: Types.ComposeDuration?
}

class Deploy {
  replicas: UInt?
  resources: Resources?
}

class Resources {
  limits: ResourceSpec?
  reservations: ResourceSpec?
}

class ResourceSpec {
  cpus: String(matches(Regex(#"^\d+(\.\d+)?$"#)))?
  memory: Types.ComposeBytes?
  pids: UInt?
}

class Logging {
  driver: String
  options: Mapping<String, String>
}

class Volume {
  name: Types.DockerName
  driver: String?
  driver_opts: Mapping<String, String>
  `external`: Boolean?
  labels: Mapping<String, String>
}

class Network {
  name: Types.DockerName
  driver: String?
  driver_opts: Mapping<String, String>
  `external`: Boolean?
  internal: Boolean?
  enable_ipv6: Boolean?
  labels: Mapping<String, String>
}
