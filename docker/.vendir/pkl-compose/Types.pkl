/// Shared typealiases and helpers for the compose library.
///
/// Naming follows `_collections/naming-spec.md`: Docker names are T1
/// (`a-z 0-9 -`, `-` separates fields, words inside a field concatenate).
module Types

/// The role a service plays in its stack. Mirrors `collections.role` in infra.stacks.
typealias Role =
  "secrets"
  | "app" | "proxy" | "web" | "api" | "assets"
  | "dns"
  | "server" | "agent" | "tunnel" | "worker" | "scheduler" | "consumer" | "runner"
  | "db" | "cache" | "queue" | "search" | "storage" | "vector"
  | "migrate" | "seeder" | "backup"
  | "metrics" | "logs" | "mail"
  | "ml" | "converter" | "parser" | "collab" | "watchdog" | "janitor"
  | "media" | "tv" | "movies" | "indexer" | "subtitles" | "downloader" | "requests"

/// A service key: a role, or a role qualified by one field (`secrets-traefik`) when a
/// stack runs two services of the same role.
typealias ServiceKey = String(isServiceKey(this))

const function isServiceKey(key: String): Boolean =
  key is Role
  || (key.split("-").length == 2 && key.split("-")[0] is Role && key.split("-")[1] is Field)

typealias IP =
  "127.0.0.1"

/// One T1 field: lowercase alphanumerics, no separator.
typealias Field = String(matches(Regex(#"^[a-z0-9]+$"#)))

/// A T1 name: one or more fields joined by `-`.
typealias T1Name = String(matches(Regex(#"^[a-z0-9]+(-[a-z0-9]+)*$"#)))

/// What Docker itself accepts for a volume or network name.
typealias DockerName = String(matches(Regex(#"^[a-z0-9][a-z0-9_.-]*$"#)))

/// A host port window, `start-end`. Docker picks one free port from it per container.
typealias PortRange = String(matches(Regex(#"^\d{1,5}-\d{1,5}$"#)))

/// Compose accepts `us ms s m h`. Pkl spells minutes `min`; the renderer maps it.
typealias ComposeDuration = Duration(unit != "ns" && unit != "d")

/// Docker byte units `k m g` are binary, so only binary Pkl units are accepted.
typealias ComposeBytes = DataSize(unit == "b" || unit == "kib" || unit == "mib" || unit == "gib")

function renderDuration(duration: Duration): String =
  "\(duration.value)\(if (duration.unit == "min") "m" else duration.unit)"

function renderBytes(size: DataSize): String =
  "\(size.value)\(size.unit.take(1))"
